# Managed by io.github.stellarsunset.java-conventions 0.0.6 - regenerate with
# ./gradlew applyRepoTemplate; do not hand-edit.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 2
ij_continuation_indent_size = 4
# Never collapse imports into wildcards; matches google-java-format / Spotless.
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

[*.{kt,kts}]
indent_size = 4

[*.{json,json5,yml,yaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
